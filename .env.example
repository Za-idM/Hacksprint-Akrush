# ===== Sarvam (translation + voice) =====
# Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=your_gcp_api_key_here

# ===== Gemini (AI brain) =====
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gcp_api_key_here

# Gemini model
GEMINI_MODEL=gemini-2.5-flash

# Fallback reply language when detection fails (BCP-47)
DEFAULT_LANGUAGE_CODE=en-IN

# ===== Email (Gmail) =====
# 1) Enable 2FA on your Google account
# 2) Generate an App Password at https://myaccount.google.com/apppasswords
EMAIL_USER=yourbot@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM_NAME=Akrush
EMAIL_FROM_ADDRESS=yourbot@gmail.com

# ===== Owner =====
# WhatsApp JID of the phone you personally use (so bot knows who YOU are)
# Format: <number>@s.whatsapp.net  e.g. 919876543210@s.whatsapp.net
OWNER_JID=

# ===== Behavior =====
# Reply delay range in seconds (anti-spam)
REPLY_DELAY_MIN=5
REPLY_DELAY_MAX=15

# Per-chat rate limit: max messages the bot will send per minute
RATE_LIMIT_PER_MIN=20

# How many recent messages to feed back to the LLM as context
HISTORY_LIMIT=20

# Bot name
BOT_NAME=Akrush

# Send voice-note replies via Sarvam TTS (true/false)
VOICE_REPLIES=true
