# ===== AI (Groq) =====
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Groq model (llama-3.3-70b-versatile, llama-3.1-8b-instant, etc.)
GROQ_MODEL=llama-3.3-70b-versatile

# ===== Email (Gmail) =====
# 1) Enable 2FA on your Google account
# 2) Generate an App Password at https://myaccount.google.com/apppasswords
EMAIL_USER=yourbot@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM_NAME=Zaid Bot
EMAIL_FROM_ADDRESS=yourbot@gmail.com

# ===== Owner =====
# WhatsApp JID of the phone you personally use (so bot knows who YOU are)
# Format: <number>@s.whatsapp.net  e.g. 919876543210@s.whatsapp.net
OWNER_JID=

# ===== Behavior =====
# Reply delay range in seconds (anti-spam, per Reddit advice)
REPLY_DELAY_MIN=5
REPLY_DELAY_MAX=15

# Per-chat rate limit: max messages the bot will send per minute
RATE_LIMIT_PER_MIN=20

# How many recent messages to feed back to the LLM as context
HISTORY_LIMIT=20

# Bot personality/system prompt fallback (in addition to data/profile.md)
BOT_NAME=Aria